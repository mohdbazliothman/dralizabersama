# Required before production. Absolute HTTPS domain; rebuild after changes.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Kept for compatibility; not used by this server-only submission implementation.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CAMPAIGN_NOTIFICATION_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Additional required settings: sender on a Resend-verified domain; random 32+ byte secrets.
RESEND_FROM_EMAIL=
RATE_LIMIT_SECRET=
CRON_SECRET=
# Optional. Disabled while empty; explicit visitor consent also required.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
